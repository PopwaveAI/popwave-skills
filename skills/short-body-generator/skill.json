{
  "id": "short-body-generator",
  "version": "2.2.1",
  "displayName": "正文生成器",
  "description": "当用户说「生成正文/写正文」时用它，也在剧情结构定好、要出短篇正文时进。按结构把正文写出来，可选文风、逐段或一键生成。",
  "entry": "SKILL.md",
  "activation": {
    "slashCommands": [
      "生成正文",
      "写正文"
    ],
    "default": false
  },
  "permissions": {
    "readProjectFiles": true,
    "writeProjectFiles": true,
    "network": false,
    "shell": false
  },
  "tags": [
    "短篇小说专家"
  ],
  "author": "popwave",
  "license": "UNLICENSED",
  "loadPolicy": {
    "includeReferences": "on-demand",
    "maxPromptChars": 80000
  }
}