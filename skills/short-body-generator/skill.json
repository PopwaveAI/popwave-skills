{
  "id": "short-body-generator",
  "version": "1.0.0",
  "displayName": "正文生成器",
  "description": "当用户完成剧情结构设计后进入正文生成时启用。文风选择→逐段/一键生成正文→去AI味儿。支持用户上传参考文本学习文风，逐段确认覆盖付费钩子特殊处理。",
  "entry": "SKILL.md",
  "activation": {
    "slashCommands": ["生成正文", "写正文"],
    "default": false
  },
  "permissions": {
    "readProjectFiles": true,
    "writeProjectFiles": true,
    "network": false,
    "shell": false
  },
  "tags": ["短篇创作", "正文生成"],
  "author": "popwave",
  "license": "UNLICENSED",
  "loadPolicy": {
    "includeReferences": "on-demand",
    "maxPromptChars": 80000
  }
}
