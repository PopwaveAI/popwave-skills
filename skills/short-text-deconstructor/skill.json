{
  "id": "short-text-deconstructor",
  "version": "2.2.1",
  "displayName": "拆文分析器",
  "description": "当用户说「拆文/拆解/拆这篇例文」时用它，也在要学一篇精品的写法时进。分析例文的结构、角色、开篇与文风，产出拆解结论。随时可调用。",
  "entry": "SKILL.md",
  "activation": {
    "slashCommands": [
      "拆文",
      "拆解"
    ],
    "default": false
  },
  "permissions": {
    "readProjectFiles": true,
    "writeProjectFiles": false,
    "network": false,
    "shell": false
  },
  "tags": [
    "短篇小说专家"
  ],
  "author": "popwave",
  "license": "UNLICENSED",
  "loadPolicy": {
    "includeReferences": "on-demand",
    "maxPromptChars": 80000
  }
}