{
  "id": "tool-download-webnovel",
  "version": "7.4.2",
  "displayName": "网文搜索下载TXT",
  "description": "当用户说「下载小说/把某本书下成TXT」时用它，也就是用户点名要某部网文原文时进。按书名与作者搜索下载并校验，交付干净的 TXT。",
  "tags": [
    "番茄长篇网文专家",
    "起点长篇网文专家",
    "网文拆书专家"
  ],
  "pipeline": {
    "upstream": [],
    "downstream": [
      "pop-decon"
    ]
  },
  "entry": "SKILL.md",
  "activation": {
    "slashCommands": [
      "下载小说",
      "tool-download-webnovel"
    ],
    "default": false
  },
  "permissions": {
    "readProjectFiles": true,
    "writeProjectFiles": true,
    "network": true,
    "shell": true
  },
  "loadPolicy": {
    "includeReferences": "on-demand",
    "maxPromptChars": 20000
  }
}